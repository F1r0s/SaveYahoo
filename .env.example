# SaveYahoo Production Configuration
APP_URL="https://saveyahoo.ai.studio"
PORT=3000

# Gemini API Key (Server-side AI blog extraction and insights)
GEMINI_API_KEY=""

# Optional Rotating Residential Proxy (To bypass Yahoo/Akamai CDN datacenter IP blocks)
# Example: http://user:pass@pr.oxylabs.io:7777 or http://residential-proxy.webshare.io:80
PROXY_URL=""
HTTP_PROXY=""

# PostgreSQL / Neon Database (Connection Pooling with SSL)
DATABASE_URL="postgresql://[USER]:[PASSWORD]@[ENDPOINT]-pooler.[REGION].aws.neon.tech/saveyahoo?sslmode=require"

# Admin Authentication & Security
ADMIN_USERNAME="admin"
ADMIN_PASSWORD_HASH=""
ADMIN_SECRET_KEY="generate-a-strong-random-32-byte-secret"
SESSION_SECRET="generate-a-strong-random-session-secret"
