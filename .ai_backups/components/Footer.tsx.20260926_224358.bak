import React from 'react';
import Link from 'next/link';
import { Lock } from 'lucide-react';

export default function Footer() {
  const currentYear = 2026;

  return (
    <footer className="bg-white border-t border-slate-200 text-slate-600 text-xs">
      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div className="grid grid-cols-2 md:grid-cols-4 gap-8 mb-10">
          {/* Brand Col */}
          <div className="col-span-2 md:col-span-1 space-y-3">
            <Link
              href="/"
              className="text-lg font-bold tracking-tight text-slate-900 flex items-center gap-2"
            >
              <span className="w-6 h-6 rounded bg-[#6001d2] text-white flex items-center justify-center font-black text-xs">
                Y!
              </span>
              <span>Save<span className="text-[#6001d2]">Yahoo</span></span>
            </Link>
            <p className="text-slate-500 leading-relaxed text-xs">
              Fast, high-fidelity browser utility for downloading Yahoo Videos, extracting audio tracks, and archiving blog articles.
            </p>
            <div className="text-[11px] text-slate-400">
              Domain: <span className="font-mono text-slate-600">www.saveyahoo.ai.studio</span>
            </div>
          </div>

          {/* Tools */}
          <div className="space-y-2.5">
            <h4 className="font-bold text-slate-900 text-xs uppercase tracking-wider">
              Media Tools
            </h4>
            <ul className="space-y-2">
              <li>
                <Link href="/video-downloader" className="hover:text-slate-900 transition-colors">
                  Yahoo Video Downloader
                </Link>
              </li>
              <li>
                <Link href="/audio-converter" className="hover:text-slate-900 transition-colors">
                  Yahoo MP3 Audio Extractor
                </Link>
              </li>
              <li>
                <Link href="/blog-reader" className="hover:text-slate-900 transition-colors">
                  Yahoo Blog & Article Reader
                </Link>
              </li>
            </ul>
          </div>

          {/* Programmatic SEO & Crawlers */}
          <div className="space-y-2.5">
            <h4 className="font-bold text-slate-900 text-xs uppercase tracking-wider">
              pSEO & Sitemaps
            </h4>
            <ul className="space-y-2">
              <li>
                <Link href="/directory" className="hover:text-slate-900 transition-colors">
                  Topic Catalog Directory
                </Link>
              </li>
              <li>
                <a
                  href="/sitemap.xml"
                  target="_blank"
                  rel="noreferrer"
                  className="hover:text-slate-900 transition-colors inline-flex items-center gap-1"
                >
                  <FileCode2 className="w-3 h-3 text-[#6001d2]" />
                  <span>Sitemap Index (sitemap.xml)</span>
                </a>
              </li>
              <li>
                <a
                  href="/sitemap_1.xml"
                  target="_blank"
                  rel="noreferrer"
                  className="hover:text-slate-900 transition-colors"
                >
                  Partition 1 (sitemap_1.xml)
                </a>
              </li>
              <li>
                <a
                  href="/robots.txt"
                  target="_blank"
                  rel="noreferrer"
                  className="hover:text-slate-900 transition-colors"
                >
                  Crawler Directives (robots.txt)
                </a>
              </li>
            </ul>
          </div>

          {/* Legal & Governance */}
          <div className="space-y-2.5">
            <h4 className="font-bold text-slate-900 text-xs uppercase tracking-wider">
              Compliance & Legal
            </h4>
            <ul className="space-y-2">
              <li>
                <Link href="/video-downloader#faq" className="hover:text-slate-900 transition-colors">
                  Terms of Fair Use
                </Link>
              </li>
              <li>
                <Link href="/video-downloader#faq" className="hover:text-slate-900 transition-colors">
                  Privacy Policy
                </Link>
              </li>
              <li>
                <Link href="/video-downloader#faq" className="hover:text-slate-900 transition-colors">
                  DMCA Contact & Inquiries
                </Link>
              </li>
              <li>
                <Link
                  href="/secretadmin"
                  className="inline-flex items-center gap-1 text-slate-400 hover:text-slate-700 transition-colors"
                  title="Team Administrator Gateway"
                >
                  <Lock className="w-3 h-3" />
                  <span>Admin Gateway</span>
                </Link>
              </li>
            </ul>
          </div>
        </div>

        {/* Bottom Bar */}
        <div className="pt-8 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-slate-500">
          <div>
            &copy; {currentYear} SaveYahoo. All rights reserved. Built with clean, decoupled architecture.
          </div>
          <div>
            Personal fair-use and educational research utility. Not affiliated with Yahoo Inc.
          </div>
        </div>
      </div>
    </footer>
  );
}
