'use client';

import React, { useState } from 'react';
import {
  Download,
  Clipboard,
  Sparkles,
  AlertCircle,
  Loader2,
  Check,
  Video,
  Music,
  FileText,
} from 'lucide-react';
import { ParsedYahooMedia } from '@/lib/types';
import { downloadParserService } from '@/lib/download/parser-service';
import DownloadResultCard from './DownloadResultCard';

interface HeroDownloaderProps {
  initialPreset?: ParsedYahooMedia;
  headline?: string;
  subheadline?: string;
  defaultFormat?: 'video' | 'audio' | 'blog';
}

export default function HeroDownloader({
  initialPreset,
  headline = 'Yahoo Media & Blog Downloader',
  subheadline = 'Paste any Yahoo Video, News clip, Sports highlight, or Lifestyle blog URL to extract 1080p MP4, studio-grade MP3 audio, or clean reader text in seconds.',
  defaultFormat = 'video',
}: HeroDownloaderProps) {
  const [urlInput, setUrlInput] = useState<string>(initialPreset?.url || '');
  const [isLoading, setIsLoading] = useState<boolean>(false);
  const [errorMsg, setErrorMsg] = useState<string | null>(null);
  const [parsedData, setParsedData] = useState<ParsedYahooMedia | null>(initialPreset || null);
  const [copiedPasted, setCopiedPasted] = useState<boolean>(false);

  const presets = downloadParserService.getSamplePresets();

  const handlePaste = async () => {
    try {
      const text = await navigator.clipboard.readText();
      if (text) {
        setUrlInput(text);
        setCopiedPasted(true);
        setTimeout(() => setCopiedPasted(false), 2000);
      }
    } catch {
      // In some browser sandboxes clipboard read is restricted, prompt fallback
      setErrorMsg('Please paste the URL directly into the box.');
    }
  };

  const handleProcessUrl = async (targetUrl?: string) => {
    const toProcess = (targetUrl !== undefined ? targetUrl : urlInput).trim();
    if (!toProcess) {
      setErrorMsg('Please enter or select a Yahoo URL.');
      return;
    }

    setErrorMsg(null);
    setIsLoading(true);

    try {
      // Call decoupled parser service
      const res = await downloadParserService.parseUrl(toProcess);
      if (res.success && res.data) {
        setParsedData(res.data);
      } else {
        setErrorMsg(res.error || 'Unable to parse this link. Please check the URL format.');
      }
    } catch {
      setErrorMsg('A network error occurred while parsing. Please try again.');
    } finally {
      setIsLoading(false);
    }
  };

  const handleSelectPreset = (item: ParsedYahooMedia) => {
    setUrlInput(item.url);
    setParsedData(item);
    setErrorMsg(null);
  };

  return (
    <section id="downloader" className="relative pt-12 pb-16 px-4 sm:px-6 lg:px-8 max-w-5xl mx-auto">
      {/* Editorial Headline */}
      <div className="text-center space-y-3 mb-8">
        <div className="inline-flex items-center gap-1.5 text-xs font-semibold text-[#6001d2] bg-purple-50 px-3 py-1 rounded-full mb-1">
          <Sparkles className="w-3.5 h-3.5" />
          <span>SaveYahoo Engine v2.4 · 100% Free · No Software Needed</span>
        </div>

        <h1 className="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight text-slate-900 text-balance max-w-3xl mx-auto">
          {headline}
        </h1>

        <p className="text-sm sm:text-base text-slate-600 max-w-2xl mx-auto text-balance leading-relaxed">
          {subheadline}
        </p>
      </div>

      {/* Main Paste Box */}
      <div className="bg-white border-2 border-[#6001d2]/20 hover:border-[#6001d2]/50 focus-within:border-[#6001d2] focus-within:ring-4 focus-within:ring-[#6001d2]/10 rounded-2xl shadow-lg p-2 sm:p-2.5 transition-all mb-4">
        <form
          onSubmit={(e) => {
            e.preventDefault();
            handleProcessUrl();
          }}
          className="flex flex-col sm:flex-row items-stretch gap-2"
        >
          <div className="relative flex-1 flex items-center min-w-0">
            <input
              type="text"
              value={urlInput}
              onChange={(e) => setUrlInput(e.target.value)}
              placeholder="Paste Yahoo URL here (e.g. news.yahoo.com/..., finance.yahoo.com/...)"
              className="w-full pl-4 pr-24 py-3 sm:py-3.5 text-sm sm:text-base text-slate-900 placeholder:text-slate-400 bg-transparent border-0 focus:outline-none focus:ring-0"
              autoComplete="off"
              spellCheck="false"
            />

            {/* Paste Button inside input */}
            <button
              type="button"
              onClick={handlePaste}
              className="absolute right-2 inline-flex items-center gap-1 px-3 py-1.5 text-xs font-semibold text-slate-600 hover:text-slate-900 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors"
              title="Paste from clipboard"
            >
              {copiedPasted ? (
                <>
                  <Check className="w-3.5 h-3.5 text-emerald-600" />
                  <span className="text-emerald-700">Pasted</span>
                </>
              ) : (
                <>
                  <Clipboard className="w-3.5 h-3.5" />
                  <span>Paste</span>
                </>
              )}
            </button>
          </div>

          <button
            type="submit"
            disabled={isLoading}
            className="inline-flex items-center justify-center gap-2 px-7 py-3 sm:py-3.5 text-sm sm:text-base font-bold text-white bg-[#6001d2] hover:bg-[#4e00a8] active:scale-98 rounded-xl shadow-md transition-all disabled:opacity-70 whitespace-nowrap cursor-pointer"
          >
            {isLoading ? (
              <>
                <Loader2 className="w-5 h-5 animate-spin" />
                <span>Fetching...</span>
              </>
            ) : (
              <>
                <Download className="w-5 h-5" />
                <span>Download</span>
              </>
            )}
          </button>
        </form>
      </div>

      {/* Error Banner */}
      {errorMsg && (
        <div className="mb-6 p-3.5 bg-rose-50 border border-rose-200 rounded-xl flex items-center gap-2.5 text-xs sm:text-sm text-rose-700">
          <AlertCircle className="w-4 h-4 shrink-0" />
          <span>{errorMsg}</span>
        </div>
      )}

      {/* Quick Test Presets (Instant 1-Click Verification) */}
      <div className="mb-8 pt-1">
        <div className="flex items-center justify-between text-xs text-slate-500 mb-2 font-medium">
          <span>Or test with live Yahoo sample items:</span>
          <span className="hidden sm:inline text-slate-400">Click any preset to preview</span>
        </div>
        <div className="flex flex-wrap gap-2">
          {presets.map((item) => {
            const isSelected = parsedData?.id === item.id;
            return (
              <button
                key={item.id}
                type="button"
                onClick={() => handleSelectPreset(item)}
                className={`inline-flex items-center gap-1.5 px-3 py-1.5 text-xs rounded-lg border transition-all text-left ${
                  isSelected
                    ? 'bg-purple-50 border-[#6001d2] text-[#6001d2] font-semibold shadow-xs'
                    : 'bg-white border-slate-200 text-slate-700 hover:border-slate-300 hover:bg-slate-50'
                }`}
              >
                {item.primaryType === 'video' ? (
                  <Video className="w-3.5 h-3.5 text-[#6001d2]" />
                ) : item.primaryType === 'audio' ? (
                  <Music className="w-3.5 h-3.5 text-amber-600" />
                ) : (
                  <FileText className="w-3.5 h-3.5 text-emerald-600" />
                )}
                <span className="font-medium text-slate-900">{item.category}:</span>
                <span className="truncate max-w-[170px] sm:max-w-[210px]">{item.title}</span>
              </button>
            );
          })}
        </div>
      </div>

      {/* Parsed Result Showcase */}
      {parsedData && (
        <div className="animate-in fade-in-50 duration-300">
          <DownloadResultCard media={parsedData} />
        </div>
      )}
    </section>
  );
}
