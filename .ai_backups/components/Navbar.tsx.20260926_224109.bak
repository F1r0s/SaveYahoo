'use client';

import React, { useState } from 'react';
import Link from 'next/link';
import { Menu, X, DownloadCloud } from 'lucide-react';

export default function Navbar() {
  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);

  return (
    <header className="sticky top-0 z-50 bg-white/95 backdrop-blur-md border-b border-slate-200 transition-colors">
      <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div className="flex items-center justify-between h-16">
          {/* Zone 1: Single text element Brand Zone */}
          <Link
            href="/"
            className="text-xl font-bold tracking-tight text-slate-900 flex items-center gap-2 group"
          >
            <span className="w-8 h-8 rounded-lg bg-[#6001d2] text-white flex items-center justify-center font-black text-sm group-hover:bg-[#4b0082] transition-colors">
              Y!
            </span>
            <span>Save<span className="text-[#6001d2]">Yahoo</span></span>
          </Link>

          {/* Zone 2: 4-6 clean text navigation links */}
          <nav className="hidden md:flex items-center gap-7 text-sm font-medium text-slate-600">
            <Link href="/video-downloader" className="hover:text-slate-900 transition-colors">
              Video Downloader
            </Link>
            <Link href="/audio-converter" className="hover:text-slate-900 transition-colors">
              Audio MP3
            </Link>
            <Link href="/blog-reader" className="hover:text-slate-900 transition-colors">
              Blog Reader
            </Link>
            <Link href="/directory" className="hover:text-slate-900 transition-colors">
              pSEO Directory
            </Link>
            <Link href="#faq" className="hover:text-slate-900 transition-colors">
              FAQ & Guides
            </Link>
          </nav>

          {/* Zone 3: Primary Action */}
          <div className="hidden sm:flex items-center gap-3">
            <a
              href="#downloader"
              className="inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold text-white bg-[#6001d2] hover:bg-[#4e00a8] rounded-lg shadow-sm transition-all whitespace-nowrap active:scale-95"
            >
              <DownloadCloud className="w-4 h-4" />
              <span>Quick Paste</span>
            </a>
          </div>

          {/* Mobile menu trigger */}
          <div className="flex md:hidden">
            <button
              type="button"
              onClick={() => setMobileMenuOpen(!mobileMenuOpen)}
              className="p-2 rounded-md text-slate-600 hover:text-slate-900 hover:bg-slate-100"
              aria-label="Toggle menu"
            >
              {mobileMenuOpen ? <X className="w-6 h-6" /> : <Menu className="w-6 h-6" />}
            </button>
          </div>
        </div>
      </div>

      {/* Mobile Drawer */}
      {mobileMenuOpen && (
        <div className="md:hidden border-b border-slate-200 bg-white px-4 pt-3 pb-5 space-y-2">
          <Link
            href="/video-downloader"
            onClick={() => setMobileMenuOpen(false)}
            className="block px-3 py-2 text-base font-medium text-slate-700 hover:bg-slate-50 rounded-md"
          >
            Video Downloader
          </Link>
          <Link
            href="/audio-converter"
            onClick={() => setMobileMenuOpen(false)}
            className="block px-3 py-2 text-base font-medium text-slate-700 hover:bg-slate-50 rounded-md"
          >
            Audio MP3 Converter
          </Link>
          <Link
            href="/blog-reader"
            onClick={() => setMobileMenuOpen(false)}
            className="block px-3 py-2 text-base font-medium text-slate-700 hover:bg-slate-50 rounded-md"
