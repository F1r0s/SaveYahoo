import crypto from 'node:crypto';
import { AdminSession, AdminUser, AuthResult, IAuthProvider } from './types';

const activeSessions = new Map<string, AdminSession>();
const loginAttempts = new Map<string, { count: number; lockedUntil: number }>();

function timingSafeMatch(candidate: string, target: string): boolean {
  if (!candidate || !target) return false;
  const bufA = Buffer.from(candidate);
  const bufB = Buffer.from(target);
  if (bufA.length !== bufB.length) {
    crypto.timingSafeEqual(bufA, bufA);
    return false;
  }
  return crypto.timingSafeEqual(bufA, bufB);
}

export class ModularAuthProvider implements IAuthProvider {
  readonly providerName = 'Modular Memory Provider (Postgres Ready)';
  readonly isDatabaseConnected = false;

  async validateCredentials(passkey: string): Promise<AuthResult> {
    const trimmed = passkey.trim();
    if (!trimmed) {
      return { success: false, message: 'Passkey cannot be empty' };
    }

    const configuredKey = process.env.ADMIN_SECRET_KEY || '';
    if (!configuredKey) {
      return { success: false, message: 'ADMIN_SECRET_KEY environment variable is not configured.' };
    }

    if (timingSafeMatch(trimmed, configuredKey)) {
      const token = `syo_${crypto.randomBytes(32).toString('hex')}`;
      const user: AdminUser = {
        id: 'usr_admin_root',
        username: process.env.ADMIN_USERNAME || 'SaveYahoo Administrator',
        role: 'superadmin',
        createdAt: new Date().toISOString(),
      };

      const session: AdminSession = {
        token,
        user,
        expiresAt: Date.now() + 1000 * 60 * 60 * 24 * 7, // 7 days
      };

      activeSessions.set(token, session);

      return {
        success: true,
        session,
        message: 'Authentication successful',
      };
    }

    return {
      success: false,
      message: 'Invalid passkey. Default developer passkey is: saveyahoo-admin-2026',
    };
  }

  async verifySession(token: string): Promise<AdminUser | null> {
    if (!token) return null;
    const session = activeSessions.get(token);
    if (!session) return null;
    if (Date.now() > session.expiresAt) {
      activeSessions.delete(token);
      return null;
    }
    return session.user;
  }

  async revokeSession(token: string): Promise<boolean> {
    return activeSessions.delete(token);
  }

  async getSystemHealth() {
    return {
      status: 'operational',
      uptime: process.uptime ? Math.floor(process.uptime()) : 3600,
      provider: this.providerName,
    };
  }
}
